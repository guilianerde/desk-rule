var root = self;
var stopPending = false;
var connectPending = false;
var lastAddresses = "";

function fingerprintHex(value) {
    return (value || "").replace(/[^0-9a-fA-F]/g, "").toLowerCase();
}

function formatFingerprint(value) {
    var hex = fingerprintHex(value);
    var out = "";
    for (var i = 0; i < hex.length; i += 8) {
        if (i > 0) out += " ";
        out += hex.substring(i, i + 8);
    }
    return out;
}

function copyText(text, button) {
    if (!text) return;
    try {
        Clipboard.writeText(text);
        button.text = translate("Copied");
        root.timer(1200ms, function() { button.text = translate("Copy"); });
    } catch (e) {
        button.text = translate("Copy failed");
    }
}

function renderAddresses(value) {
    var list = [];
    var parts = (value || "").split("\n");
    for (var i = 0; i < parts.length; i++) {
        if (parts[i]) list.push(parts[i]);
    }
    if (list.join("\n") == lastAddresses) return;
    lastAddresses = list.join("\n");
    var has = list.length > 0;
    $(#local-addresses).style#display = has ? "inline-block" : "none";
    $(#copy-address).style#display = has ? "inline-block" : "none";
    $(#no-address).style#display = has ? "none" : "block";
    if (!has) return;
    var html = "";
    for (var i = 0; i < list.length; i++) {
        html += "<option>" + list[i] + "</option>";
    }
    $(#local-addresses).html = html;
}

function updateFingerprintHint() {
    var length = fingerprintHex($(#fingerprint).value).length;
    var hint = $(#fingerprint-hint);
    if (length == 0) {
        hint.text = translate("Compare each character with the fingerprint shown on the controlled device.");
        hint.attributes.toggleClass("ok", false);
    } else if (length == 64) {
        hint.text = translate("Fingerprint format looks correct.");
        hint.attributes.toggleClass("ok", true);
    } else {
        hint.text = translate("{" + length + "} of 64 characters.");
        hint.attributes.toggleClass("ok", false);
    }
}

function connectNow() {
    if (connectPending) return;
    var raw = ($(#peer).value || "").trim();
    var address = raw ? handler.normalize_direct_address(raw) : "";
    if (!address) {
        $(#error).text = translate("Enter a valid device IP address.");
        view.focus = $(#peer);
        return;
    }
    var fingerprint = fingerprintHex($(#fingerprint).value);
    if (fingerprint.length != 64) {
        $(#error).text = translate("Enter the 64-character fingerprint shown on the controlled device.");
        view.focus = $(#fingerprint);
        return;
    }
    $(#error).text = "";
    handler.set_local_option("peer-fingerprint-" + address, fingerprint);
    connectPending = true;
    var button = $(#connect);
    button.state.disabled = true;
    button.text = translate("Connecting...");
    root.timer(4s, function() {
        if (!connectPending) return;
        connectPending = false;
        button.state.disabled = false;
        button.text = translate("Connect");
    });
    handler.new_remote(address, "connect", false);
}

function refreshHost() {
    var enabled = handler.get_option("stop-service") == "N";
    if (!stopPending) $(#sharing).text = translate(enabled ? "Stop sharing" : "Start sharing");
    $(#share-text).text = translate(enabled ? "Sharing on port 21118" : "Not sharing");
    $(#share-dot).attributes.toggleClass("on", enabled);
    $(#host-info).style#display = enabled ? "block" : "none";
    if (enabled) {
        var fingerprint = formatFingerprint(handler.get_fingerprint());
        if ($(#local-fingerprint).text != fingerprint) $(#local-fingerprint).text = fingerprint;
        var password = handler.temporary_password();
        if ($(#local-passcode).value != password) $(#local-passcode).value = password;
        renderAddresses(handler.direct_addresses());
    }
    return true;
}

event change $(#peer) {
    var raw = ($(#peer).value || "").trim();
    $(#error).text = "";
    if (!raw) {
        $(#fingerprint).value = "";
        updateFingerprintHint();
        return;
    }
    var address = handler.normalize_direct_address(raw) || raw;
    var saved = handler.get_local_option("peer-fingerprint-" + address);
    if (!saved && address != raw) {
        saved = handler.get_local_option("peer-fingerprint-" + raw);
    }
    $(#fingerprint).value = fingerprintHex(saved);
    updateFingerprintHint();
}

event change $(#fingerprint) {
    $(#fingerprint).value = fingerprintHex($(#fingerprint).value);
    updateFingerprintHint();
    $(#error).text = "";
}

event keyup $(#fingerprint) {
    updateFingerprintHint();
}

event keydown $(#peer) (evt) {
    $(#error).text = "";
    if (!evt.shortcutKey && isEnterKey(evt)) connectNow();
}

event keydown $(#fingerprint) (evt) {
    $(#error).text = "";
    if (!evt.shortcutKey && isEnterKey(evt)) connectNow();
}

event click $(#connect) {
    connectNow();
}

event click $(#sharing) {
    $(#host-error).text = "";
    var enabled = handler.get_option("stop-service") == "N";
    if (!enabled) {
        if (!handler.request_host_permissions()) {
            $(#host-error).text = translate("Allow screen recording and accessibility in System Settings, then start sharing.");
            return;
        }
        stopPending = false;
        handler.set_option("stop-service", "N");
        refreshHost();
        return;
    }
    if (!stopPending) {
        stopPending = true;
        $(#sharing).text = translate("Click again to stop");
        root.timer(4s, function() {
            if (!stopPending) return;
            stopPending = false;
            refreshHost();
        });
        return;
    }
    stopPending = false;
    handler.set_option("stop-service", "Y");
    refreshHost();
}

event click $(#copy-address) {
    copyText($(#local-addresses).value, $(#copy-address));
}

event click $(#copy-fingerprint) {
    copyText(fingerprintHex($(#local-fingerprint).text), $(#copy-fingerprint));
}

event click $(#copy-passcode) {
    copyText($(#local-passcode).value, $(#copy-passcode));
}

event click $(#language) {
    var list = $(#language-list);
    var show = list.style#display == "none";
    list.style#display = show ? "block" : "none";
    if (!show) return;
    var selected = list.$(.lang-option.selected);
    if (selected) selected.scrollToView();
}

event mousedown (evt) {
    var list = $(#language-list);
    if (list.style#display == "none") return;
    var target = evt.target;
    if (!target) return;
    if (target == list || target.parent == list) return;
    if (target.id == "language" || target.id == "label-language") return;
    list.style#display = "none";
}

event click $(#language-list .lang-option) (_, me) {
    $(#language-list).style#display = "none";
    handler.set_local_option("lang", me.attributes["value"] || "");
    $(#error).text = "";
    $(#host-error).text = "";
    applyLanguage();
    refreshHost();
    return true;
}

function applyLanguage() {
    $(#label-language).text = translate("Language");
    var lang = handler.get_local_option("lang").toLowerCase();
    if (lang == "pt" || lang == "br") lang = "pt-br";
    $(#option-system).text = translate("Follow System");
    var names = "";
    for (var el in $$(#language-list .lang-option)) {
        var value = el.attributes["value"] || "";
        el.attributes.toggleClass("selected", value == lang);
        if (value == lang) names = el.text;
    }
    if (!names) names = $(#option-system).text;
    $(#language).text = names;
    $(#title-control).text = translate("Control Remote Desktop");
    $(#label-peer).text = translate("Device IP address");
    $(#hint-peer).text = translate("Port 21118 is used by default, e.g. 192.168.1.10 or [fd00::1]. Add :port to override.");
    $(#label-fingerprint).text = translate("Device fingerprint");
    $(#fingerprint).attributes["placeholder"] = translate("64 hex characters");
    $(#connect).text = translate("Connect");
    $(#title-allow).text = translate("Allow remote control");
    $(#label-reachable).text = translate("Reachable address");
    $(#copy-address).text = translate("Copy");
    $(#no-address).text = translate("No reachable local address detected. Check the network connection.");
    $(#hint-give).text = translate("Give the controlling device this address, the fingerprint, and the temporary password.");
    $(#label-local-fingerprint).text = translate("Fingerprint");
    $(#copy-fingerprint).text = translate("Copy");
    $(#label-passcode).text = translate("Temporary password");
    $(#local-passcode).attributes["placeholder"] = translate("Not available");
    $(#copy-passcode).text = translate("Copy");
    updateFingerprintHint();
}

function self.ready() {
    view.windowMinSize = (480, 520);
    centerize(scaleIt(660), scaleIt(720));
    applyLanguage();
    refreshHost();
    // Sciter focuses the first input on load and scrolls the first card title out of view.
    self.timer(100ms, function() { $(body).scrollTo(0, 0); });
    self.timer(1s, refreshHost);
}

function self.closing() {
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    handler.closing(x, y, w, h);
    return true;
}
